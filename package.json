{
  "name": "tayralsaad",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b",
  "scripts": {
    "build": "turbo run build",
    "build:web": "pnpm --filter @tayralsaad/web run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @tayralsaad/web run dev",
    "services": "docker compose up -d",
    "services:stop": "docker compose down",
    "services:logs": "docker compose logs -f",
    "db:seed": "pnpm --filter @tayralsaad/api run seed",
    "setup": "node scripts/dev-setup.mjs",
    "free:5173": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-port.ps1 5173",
    "free:27017": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-port.ps1 27017",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "qa": "node scripts/qa-production.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devdependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@sentry/react-native": "^8.14.0",
    "react-native-worklets-core": "^1.6.3",
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9"
  },
  "pnpm": { 
    "hoistPattern": [
      "@sentry/*",
      "react-native-worklets-core"
    ]
  }
}
